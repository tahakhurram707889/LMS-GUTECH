# Copy to .env. Obtain local values with `npx supabase status`.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# SERVER ONLY. Never add this key to frontend or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
PASSWORD_RESET_REDIRECT=http://localhost:5173/reset-password
LOG_LEVEL=info
# For HTTPS deployments with frontend/API on different sites, use none.
# Exact CLIENT_ORIGIN checks protect cookie-authenticated mutations.
COOKIE_SAME_SITE=strict
# One-time operator bootstrap only (no public signup):
# BOOTSTRAP_ADMIN_USERNAME=your-admin-username
# BOOTSTRAP_ADMIN_EMAIL=admin@your-institution.example
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-strong-password
