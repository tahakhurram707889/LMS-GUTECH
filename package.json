{
  "name": "gutech-internal-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && node --test tools/schema.test.mjs",
    "test:static": "node --test tools/schema.test.mjs",
    "test:db": "supabase test db",
    "lint": "eslint frontend/src backend/src backend/tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "supabase": "2.54.11",
    "typescript-eslint": "8.46.2"
  }
}
